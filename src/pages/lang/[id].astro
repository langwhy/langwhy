---
// One page per language: the full card when there is one, otherwise what GitHub knows about it.
import CardPage from "../../components/CardPage.astro";
import GithubPage from "../../components/GithubPage.astro";
import { allCards, githubLanguages } from "../../lib/data";

export async function getStaticPaths() {
  const cards = await allCards();
  const github = await githubLanguages();
  return [
    ...cards.map((card) => ({ params: { id: card.id }, props: { card, cards, github } })),
    ...github.filter((lang) => !lang.card).map((lang) => ({ params: { id: lang.id }, props: { lang, github } })),
  ];
}
const props = Astro.props;
---
{"card" in props ? <CardPage {...props} /> : <GithubPage {...props} />}
