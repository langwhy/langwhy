---
import { render, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { allCards, childrenOf, cardUrl, mentions, REASON } from "../../lib/data";
import { icon } from "../../lib/icons";
import { linkHtml } from "../../lib/autolink.mjs";
import { TYPES, STATUS, AXES, AXIS_TERMS, FIT_DOTS, FIT_WORD, reportUrl } from "../../lib/vocab";

export async function getStaticPaths() {
  const cards = await allCards();
  return cards.map((card) => ({ params: { id: card.id }, props: { card, cards } }));
}
const { card, cards } = Astro.props;
const byId = new Map(cards.map((c) => [c.id, c]));
const ref = (id: string) => ({ id, name: byId.get(id)?.name ?? id, href: byId.has(id) ? `/lang/${id}/` : undefined });
const parents = card.reacts_to.map(ref);
const alts = card.alternatives.map(ref);
const children = childrenOf(card.id, cards);
const proseEntry = await getEntry("prose", card.id);
const Content = proseEntry ? (await render(proseEntry)).Content : null;
const t = card.tradeoffs;
// Mentions of other languages and glossary terms link once per page, at their first appearance.
const seen = new Set<string>();
const linked = (text: string) => linkHtml(text, { self: `lang:${card.id}`, seen });
const axis = (name: string, value: string) => {
  const term = AXIS_TERMS[name]?.[value];
  const label = AXES[name][value];
  return term ? `<a class="term" href="/terms/#${term}">${label}</a>` : label;
};
const fits = card.slots.filter((s) => s.fit === "strong" || s.fit === "ok");
const misfits = card.slots.filter((s) => s.fit === "weak" || s.fit === "none");
const backlinks = ((await mentions()).get(card.id)?.mentionedBy ?? []).map((id) => byId.get(id)!).sort((a, b) => a.name.localeCompare(b.name));
const hw = card.hardware;
const title = `${card.name}: why it exists and what it is for`;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "ComputerLanguage",
  name: card.name,
  description: card.tagline,
  url: cardUrl(card.id),
  dateCreated: String(card.appeared),
  creator: card.creators.map((name) => ({ "@type": "Person", name })),
  sameAs: Object.values(card.links),
};
---
<Base title={title} description={card.tagline} path={`/lang/${card.id}/`} noindex={!card.verified} jsonld={jsonld} pagefind>
  <h1>{card.name}</h1>
  <p class="muted">
    <a href={`/#type-${card.type}`}><Fragment set:html={icon(card.type)} /> {TYPES[card.type]}</a>
    · <span class={`status ${card.status}`}>{card.status}, {STATUS[card.status]}</span>
    · since {card.appeared} · {card.creators.join(", ")}{card.org && <> · {card.org}</>}
  </p>
  <p class="lead" set:html={linked(card.tagline)} />
  {!card.verified && (
    <p class="draft">Draft from {card.last_reviewed}, not yet checked claim by claim against its sources. Spotted a mistake, or a sentence you don't understand? <a href={reportUrl(`/lang/${card.id}/`, card.name)}>Tell us in your own words.</a></p>
  )}

  <h2>Born from</h2>
  <p set:html={linked(card.born_from)} />

  <h2>What it trades away</h2>
  <div class="axes">
    <div><Fragment set:html={axis("memory", t.memory)} /><small>memory</small></div>
    <div><Fragment set:html={axis("types", t.types)} /><small>types</small></div>
    <div><Fragment set:html={axis("run", t.run)} /><small>runs as</small></div>
    <div><Fragment set:html={t.concurrency.map((c) => axis("concurrency", c)).join(", ")} /><small>concurrency</small></div>
  </div>
  <p><strong>Cost:</strong> <Fragment set:html={linked(t.cost)} /></p>

  <h2>Where it fits</h2>
  <table>
    <tbody>
      {fits.map((s) => (
        <tr><td><a href={`/slot/${s.slot}/`}>{s.slot}</a></td><td class="mono" title={FIT_WORD[s.fit]}>{FIT_DOTS[s.fit]}</td><td class="muted" set:html={linked(s.note ?? "")} /></tr>
      ))}
    </tbody>
  </table>

  <h2 id="why-not">Where it doesn't, and why</h2>
  <ul class="whynot">
    {misfits.map((s) => (
      <li>
        <span class="slotname"><a href={`/slot/${s.slot}/`}>{s.slot}</a> <span class="mono" title={FIT_WORD[s.fit]}>{FIT_DOTS[s.fit]}</span></span>
        <a class="reason" href={`/basics/#${s.reason}`}>{REASON.get(s.reason!)?.title}</a>
        <span set:html={linked(s.note ?? "")} /> <a class="src" href={s.source}>source</a>
      </li>
    ))}
  </ul>
  <p class="src">●●● a usual pick · ●●○ works · ●○○ possible, with a catch · ○○○ practically never. <a href="/basics/">The basics</a> explain the seven reasons.</p>
  {hw && (hw.twelve_dollar_users || hw.multicore_users) && (
    <p class="src">
      Same API, same server, every language, in the <a href={hw.source}>arjaythedev benchmarks</a> ({hw.measured}):
      {hw.twelve_dollar_users && <> {hw.twelve_dollar_users.toLocaleString("en")} users held on 1 vCPU / 2 GB</>}
      {hw.multicore_users && <>, {hw.multicore_users.toLocaleString("en")} on 8 vCPU / 16 GB with Postgres</>}.
      {hw.gpu && <> GPU: {hw.gpu}.</>}
    </p>
  )}

  {Content && <div class="prose"><Content /></div>}

  <h2>Named wins</h2>
  <ul>{card.won_where.map((w) => <li><Fragment set:html={linked(w.what)} /> <a class="src" href={w.source}>source</a></li>)}</ul>

  <h2>Evolution</h2>
  <p><strong>Reacts to:</strong> {parents.length ? parents.map((p, i) => <>{i > 0 && ", "}{p.href ? <a href={p.href}>{p.name}</a> : <span>{p.name}</span>}</>) : "–"}</p>
  {children.length > 0 && <p><strong>Led to:</strong> {children.map((c, i) => <>{i > 0 && ", "}<a href={`/lang/${c.id}/`}>{c.name}</a></>)}</p>}
  {backlinks.length > 0 && <p><strong>Mentioned on:</strong> {backlinks.map((c, i) => <>{i > 0 && ", "}<a href={`/lang/${c.id}/`}>{c.name}</a></>)}</p>}
  <p><strong>Weigh it against:</strong> {alts.length ? alts.map((a, i) => <>{i > 0 && ", "}{a.href ? <a href={a.href}>{a.name}</a> : <span>{a.name}</span>}</>) : "–"}</p>

  <h2>Timeline</h2>
  <ul class="timeline">
    {card.timeline.map((e) => <li><span class="year">{e.year}</span><span><Fragment set:html={linked(e.what)} /> <a class="src" href={e.source}>source</a></span></li>)}
  </ul>

  <h2>Links</h2>
  <p>
    {Object.entries(card.links).map(([k, v], i) => <>{i > 0 && " · "}<a href={v}>{k}</a></>)}
    {card.pldb && <> · <a href={`https://pldb.io/concepts/${card.pldb}.html`}>PLDB</a></>}
  </p>

  <h2>Sources</h2>
  <ol class="src">{card.sources.map((s) => <li><a href={s}>{s}</a></li>)}</ol>

  <p class="muted">
    {card.verified ? `Verified ${card.last_reviewed}.` : `Unverified draft, ${card.last_reviewed}.`}
    <a href={`/lang/${card.id}.json`}>JSON</a> · <a href={`/lang/${card.id}.md`}>Markdown</a>
  </p>
</Base>
