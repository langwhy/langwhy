---
import CardPage from "../../components/CardPage.astro";
import PldbPage from "../../components/PldbPage.astro";
import { allCards } from "../../lib/data";
import { uncarded, edges } from "../../lib/pldb";

// Every PLDB entry gets a page. A card takes its PLDB entry's place; the rest show PLDB data.
export async function getStaticPaths() {
  const cards = await allCards();
  const tree = edges(cards);
  return [
    ...cards.map((card) => ({ params: { id: card.id }, props: { card, cards } })),
    ...uncarded(cards).map((p) => ({ params: { id: p.id }, props: { pldb: p, tree, cards } })),
  ];
}
const { card, cards, pldb, tree } = Astro.props;
---
{card ? <CardPage card={card} cards={cards} /> : <PldbPage pldb={pldb!} tree={tree!} cards={cards} />}
