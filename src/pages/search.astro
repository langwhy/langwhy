---
import Base from "../layouts/Base.astro";
---
<Base title="Search langwhy" description="Search every language card." path="/search/" noindex>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <h1>Search</h1>
  <div id="search"></div>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof PagefindUI === "undefined") { document.getElementById("search").textContent = "Search index is built with the site; run pnpm build."; return; }
      new PagefindUI({ element: "#search", showSubResults: false, showImages: false, autofocus: true });
    });
  </script>
  <style is:global>
    :root { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--fg); --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--soft); --pagefind-ui-font: var(--sans); --pagefind-ui-border-radius: .5rem; --pagefind-ui-scale: .9; }
  </style>
</Base>
