---
import Base from "../layouts/Base.astro";
import { allCards } from "../lib/data";
import { icon } from "../lib/icons";
import { TYPES, ROADS } from "../lib/vocab";

const cards = await allCards();
const byId = new Map(cards.map((c) => [c.id, c]));
const groups = Object.keys(TYPES)
  .map((type) => ({ type, cards: cards.filter((c) => c.type === type) }))
  .filter((g) => g.cards.length > 0);
const roads = ROADS.map((r) => ({ want: r.want, cards: r.ids.filter((id) => byId.has(id)).map((id) => byId.get(id)!) })).filter((r) => r.cards.length);
const verified = cards.filter((c) => c.verified).length;
---
<Base title="langwhy: why every programming language exists" description="Every programming language was built because something hurt. One card per language: what pain it was born from, what it trades away, where it won, and whether it is still alive." path="/">
  <h1>Why does this language exist?</h1>
  <p class="lead">Every programming language was built because something hurt. One card per language answers four questions: what pain it was born from, what it trades away, where it won, and whether it is still alive.</p>

  <h2>Start here</h2>
  <div class="roads">
    {roads.map((r) => (
      <div>
        <strong>{r.want}</strong>
        {r.cards.map((c, i) => <>{i > 0 && ", "}<a href={`/lang/${c.id}/`}>{c.name}</a></>)}
      </div>
    ))}
  </div>

  <h2>All cards by type</h2>
  {groups.map((g) => (
    <>
      <h3 id={`type-${g.type}`}><Fragment set:html={icon(g.type)} /> {TYPES[g.type]}</h3>
      <ul class="list">
        {g.cards.map((c) => (
          <li><a href={`/lang/${c.id}/`}>{c.name}</a><span class="meta">{c.tagline}</span></li>
        ))}
      </ul>
    </>
  ))}
  <p class="muted">{cards.length} cards, {verified} verified by a human. Cards are files in a public repo: <a href="https://github.com/langwhy/langwhy/tree/main/data/languages">add one or fix one</a>.</p>
</Base>
