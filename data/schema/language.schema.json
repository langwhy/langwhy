{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://langwhy.dev/schema/language.json",
  "title": "langwhy language card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "appeared", "creators", "type", "status", "tagline", "born_from", "reacts_to", "tradeoffs", "slots", "won_where", "alternatives", "timeline", "links", "sources", "verified", "last_reviewed"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Slug, also the file name and the URL." },
    "name": { "type": "string", "minLength": 1 },
    "appeared": { "type": "integer", "minimum": 1940, "maximum": 2100, "description": "Year of first public release or announcement." },
    "creators": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "org": { "type": "string", "description": "Who maintains it today." },
    "type": { "enum": ["systems", "web", "backend", "scripting", "data", "mobile", "functional", "query", "shell", "config", "embedded", "games", "academic"], "description": "The one main area. Pick where most of its real use is." },
    "status": { "enum": ["alive", "stable", "declining", "dead"], "description": "alive = actively evolving; stable = mature, slow change; declining = losing users; dead = no activity." },
    "tagline": { "type": "string", "minLength": 20, "maxLength": 140, "description": "One sentence: what it is for. No adjectives like modern, powerful, elegant." },
    "born_from": { "type": "string", "minLength": 40, "maxLength": 600, "description": "1-3 sentences: the concrete pain that made someone build it." },
    "reacts_to": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "description": "Parent language ids it was a reaction to or borrowed from." },
    "tradeoffs": {
      "type": "object", "additionalProperties": false,
      "required": ["memory", "types", "run", "concurrency", "cost"],
      "properties": {
        "memory": { "enum": ["manual", "gc", "refcount", "ownership", "n/a"] },
        "types": { "enum": ["static", "dynamic", "gradual", "n/a"] },
        "run": { "enum": ["native", "vm", "interpreted", "to-js", "n/a"] },
        "concurrency": { "type": "array", "minItems": 1, "items": { "enum": ["threads", "green", "actors", "async", "none", "n/a"] } },
        "cost": { "type": "string", "minLength": 10, "maxLength": 200, "description": "What you pay for its strengths, one sentence." }
      }
    },
    "slots": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["slot", "fit"],
        "properties": {
          "slot": { "enum": ["browser", "server", "database", "systems", "mobile", "cli", "scripts", "data", "compute", "embedded", "wasm", "config", "games"] },
          "fit": { "enum": ["strong", "ok", "weak", "none"] },
          "note": { "type": "string", "maxLength": 160 }
        } }
    },
    "won_where": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["what", "source"],
        "properties": { "what": { "type": "string", "maxLength": 120 }, "source": { "type": "string", "format": "uri" } } }
    },
    "alternatives": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "description": "Ids of languages someone would weigh against this one." },
    "timeline": {
      "type": "array", "minItems": 3,
      "items": { "type": "object", "additionalProperties": false, "required": ["year", "what", "source"],
        "properties": { "year": { "type": "integer" }, "what": { "type": "string", "maxLength": 160 }, "source": { "type": "string", "format": "uri" } } }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gpu": { "enum": ["native", "via-libraries", "none"] },
        "twelve_dollar_users": { "type": "integer", "description": "Best entry in arjaythedev twelve-dollar-server-challenge, 1 vCPU / 2 GB." },
        "multicore_users": { "type": "integer", "description": "Best entry in arjaythedev multicore-server-challenge, 8 vCPU / 16 GB + Postgres." },
        "source": { "type": "string", "format": "uri" },
        "measured": { "type": "string", "format": "date" }
      }
    },
    "links": {
      "type": "object", "additionalProperties": false, "required": ["website"],
      "properties": {
        "website": { "type": "string", "format": "uri" },
        "repo": { "type": "string", "format": "uri" },
        "wikipedia": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" }
      }
    },
    "pldb": { "type": "string", "description": "Id of the matching PLDB concept (pldb.io/concepts/<id>.html)." },
    "sources": { "type": "array", "minItems": 2, "items": { "type": "string", "format": "uri" } },
    "verified": { "type": "boolean", "description": "true only after a human checked every claim against its source." },
    "last_reviewed": { "type": "string", "format": "date" }
  }
}
